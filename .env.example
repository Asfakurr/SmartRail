# Default: standalone in-memory simulation, no credentials needed.
NEXT_PUBLIC_DATA_MODE=demo
# To connect to emulators, set mode=firebase and USE_EMULATORS=true.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-smartrail-bd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-smartrail-bd
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-smartrail-bd-default-rtdb
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/demo-smartrail-bd/asia-south1/api
